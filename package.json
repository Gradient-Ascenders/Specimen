{
  "name": "specimen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:smoke": "playwright test tests/smoke/ProductionSmoke.spec.ts tests/smoke/OpeningGraphics.spec.ts tests/smoke/LevelSelector.spec.ts --config playwright.smoke.config.ts",
    "test:integration": "playwright test tests/smoke/CharacterDetailFallback.spec.ts tests/smoke/CleanGameplayMode.spec.ts tests/smoke/GameplayAudio.spec.ts tests/smoke/ProductionParity.spec.ts --config playwright.smoke.config.ts",
    "check:generated-assets": "node scripts/assets/check-generated-assets.mjs",
    "validate:production": "node scripts/build/validate-production-build.mjs",
    "archive": "npm run build && node scripts/build/create-production-archive.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "lucide": "1.61.0",
    "motion": "14.5.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
